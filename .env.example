# Vercel frontend: set this to your public Node API URL.
VITE_API_URL=https://your-backend.onrender.com

# Node backend: restrict browser requests to your Vercel domain.
FRONTEND_URL=https://your-project.vercel.app

# Use "ollama" locally or "openrouter" for a public deployment.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local Ollama settings (used when AI_PROVIDER=ollama).
OLLAMA_MODEL=llama3.2